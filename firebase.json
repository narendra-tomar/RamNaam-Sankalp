{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "!/js/**",
        "destination": "/index.html"
      },
      {
        "source": "!/css/**",
        "destination": "/index.html"
      },
      {
        "source": "!/images/**",
        "destination": "/index.html"
      },
      {
        "source": "!/icons/**",
        "destination": "/index.html"
      },
      {
        "source": "!/**.*",
        "destination": "/index.html"
      }
    ]
  }
}
